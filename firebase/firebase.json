{
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "hosting": {
    "public": "hosting-dist",
    "ignore": ["**/.*"],
    "redirects": [{ "source": "/", "destination": "/multi/", "type": 302 }],
    "headers": [{ "source": "**/*.@(js|html|json|webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }]
  },
  "functions": { "source": "functions", "runtime": "nodejs22" },
  "emulators": { "auth": { "port": 9099 }, "firestore": { "port": 8080 }, "functions": { "port": 5001 }, "ui": { "enabled": false } }
}
